# Supabase
# Productie: gebruik de productie Supabase URL en keys
# Test: gebruik een apart Supabase project (zie CLAUDE.md)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App URL (wordt gebruikt voor Mollie betaallinks en e-maillinks)
# Productie: https://www.stalflorida.nl
# Test/preview: de Vercel preview URL (bijv. https://stal-florida-git-develop-xxx.vercel.app)
NEXT_PUBLIC_APP_URL=https://www.stalflorida.nl

# Admin
# Wachtwoord voor het admin dashboard
ADMIN_PASSWORD=kies-een-sterk-wachtwoord

# Vercel Cron (alleen op productie actief)
# Stel in via Vercel dashboard, moet overeenkomen met de waarde in vercel.json
CRON_SECRET=kies-een-willekeurige-string

# Mollie betalingen
# Test key begint met test_, live key begint met live_
# Op de develop branch: gebruik altijd de test_ key
MOLLIE_API_KEY=test_xxxx

# E-mail (Resend)
RESEND_API_KEY=re_xxxx
EMAIL_FROM=noreply@stalflorida.nl

# SMS begeleiders (Spryng) — optioneel
SPRYNG_API_KEY=xxxx
